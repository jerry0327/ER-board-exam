H	{"schema":"precision-src-v2","source":"tintinalli-CH173.m4a","collection":"tintinalli","chapter":"tintinalli-CH173","title":"tintinalli-CH173","timebase":"source-content-1.0x","speaker_map":{"A":"lower-pitched canonical voice","B":"higher-pitched canonical voice"}}
